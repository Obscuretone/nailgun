API_KEY=
STATE_DIRECTORY=/var/lib/vps-mail
MARIADB_DATABASE=nailgun
MARIADB_USER=nailgun
MARIADB_SOCKET=/run/mysqld/mysqld.sock
MARIADB_PASSWORD_FILE=/etc/vps-mail/mariadb.password
PUBLIC_HOST=mail.example.com
SMTP_HELO=mail.example.com
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_MODE=starttls
# For authenticated SMTP, set the SMTP username and password privately.
DAILY_RECIPIENT_LIMIT=400
MAX_PENDING=1000
SEND_INTERVAL=2
